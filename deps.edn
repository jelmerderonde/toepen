{:paths ["resources" "src"]

 :deps {org.clojure/clojure                {:mvn/version "1.12.7"}
        com.taoensso/sente                 {:mvn/version "1.22.0"}
        http-kit/http-kit                  {:mvn/version "2.8.1"}
        
        metosin/reitit-core                {:mvn/version "0.11.0"}
        metosin/reitit-ring                {:mvn/version "0.11.0"}
        metosin/reitit-middleware          {:mvn/version "0.11.0"}
        metosin/reitit-frontend            {:mvn/version "0.11.0"}

        ring/ring-defaults                 {:mvn/version "0.7.1"}
        hiccup/hiccup                      {:mvn/version "2.0.0"}

        reagent/reagent                            {:mvn/version "2.0.1"
                                                    :exclusions [cljsjs/react cljsjs/react-dom]}}

 :aliases {:dev         {:extra-deps {binaryage/devtools   {:mvn/version "1.0.7"}
                                      metosin/reitit-dev   {:mvn/version "0.11.0"}}
                         :extra-paths ["dev"]}
           :shadow-cljs {:extra-deps {thheller/shadow-cljs {:mvn/version "3.5.14"}}
                         :main-opts ["-m" "shadow.cljs.devtools.cli"]}
           :depstar  {:extra-deps {com.github.seancorfield/depstar {:mvn/version "2.0.216"}}}
           :build {:deps {io.github.seancorfield/build-clj
                          {:git/tag "v0.9.2" :git/sha "9c9f078"
                           :deps/root "slim"}}
                   :ns-default build}
           :reveal-nrepl-middleware
           {:extra-deps {vlaaad/reveal {:mvn/version "RELEASE"}}
            :main-opts  ["-m" "nrepl.cmdline"
                         "--middleware" "[vlaaad.reveal.nrepl/middleware,cider.nrepl/cider-middleware]"]
            :jvm-opts ["-Dvlaaad.reveal.prefs={:theme,:light,:font-size,14}"]}}}
